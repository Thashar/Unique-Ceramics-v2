generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth.js v5 required models ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  tokenVersion  Int       @default(0)   // bump unieważnia wszystkie aktywne JWT (np. po zmianie hasła)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]

  emailChange EmailChangeRequest?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Oczekująca zmiana adresu e-mail konta.
///
/// E-mail jest jednocześnie loginem, więc podmiana wymaga udowodnienia dostępu
/// do **nowej** skrzynki – klient dostaje tam link potwierdzający.
model EmailChangeRequest {
  id     String @id @default(cuid())
  /// Jedno oczekujące żądanie na konto – nowe zastępuje poprzednie (upsert),
  /// dzięki czemu nie zbierają się ważne tokeny.
  userId String @unique
  /// Adres, na który zmieniamy – wolny w chwili żądania, sprawdzany ponownie
  /// przy potwierdzeniu (ktoś mógł go w międzyczasie zarejestrować).
  newEmail String
  /// SHA-256 tokenu. Surowy token istnieje **wyłącznie** w wysłanym mailu –
  /// wyciek bazy nie daje gotowych linków.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Sklep ────────────────────────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  userId       String?
  status       OrderStatus @default(PENDING)
  total        Float
  shippingCost Float       @default(18)

  firstName String
  lastName  String
  email     String
  phone     String?
  street    String
  city      String
  postcode  String
  country   String @default("PL")
  note      String?

  paymentMethod String @default("transfer")
  paymentStatus String @default("pending")

  shippingMethod   String  @default("courier")   // courier | parcel_locker | pickup
  parcelLockerCode String?
  trackingNumber   String?
  trackingCarrier  String?                        // DPD | DHL | InPost | PocztaPolska

  // Użyty kod rabatowy: nazwa i kwota, o jaką obniżył zamówienie.
  // Kwota jest już wliczona w ceny pozycji – pola służą do zestawień i podglądu.
  discountCode   String?
  discountAmount Float?

  // LEGACY: narzut wycofanej promocji „Wielosztuki” wliczony w ceny katalogowe
  // w chwili zakupu (null = promocja wtedy nie obowiązywała). Nowe zamówienia
  // zawsze mają tu null; pole zostaje, żeby zamówienia sprzed 24.08.2026
  // renderowały się tak, jak je złożono.
  bundleSurcharge Float?

  // Rabat ilościowy z chwili zakupu: procent zdobytego progu i kwota, o jaką
  // obniżył zamówienie. Kwota jest już wliczona w ceny pozycji – pola są śladem
  // do zestawień, podglądu i rozstrzygania sporów.
  quantityDiscountPercent Int?
  quantityDiscountAmount  Float?

  paidAt DateTime?   // data i godzina wpłaty (podana przez admina przy oznaczaniu „Opłacone"); przychód rozpoznawany wg tej daty

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  // Cena zapłacona za sztukę – po wszystkich rabatach (produktowym i kodzie)
  price     Float
  // Cena katalogowa sprzed rabatu produktowego (null dla zamówień sprzed tej
  // zmiany). Dzięki niej historia zamówienia pokazuje pełny upust, a wiersze
  // podsumowania sumują się do kwoty zapłaconej.
  basePrice Float?
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  images      String[]
  category    String   @default("inne")
  stock       Int      @default(0)
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  variesFromPhoto Boolean  @default(false)
  // Rabat produktowy w procentach (0 = brak); sumuje się z promocją „Wielosztuki”
  discountPercent Int      @default(0)
  // Okno obowiązywania rabatu (UTC; w panelu ustawiane w czasie polskim).
  // null/null = rabat bezterminowy, liczony od razu po zapisaniu produktu.
  discountStartsAt DateTime?
  discountEndsAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, featured])
  @@index([active, category])
  @@index([active, stock])
  @@index([active, featured, createdAt(sort: Desc)])
  @@index([slug, active])
}

// ─── Kody rabatowe ────────────────────────────────────────────────────────────

model DiscountCode {
  id        String    @id @default(cuid())
  code      String    @unique          // zawsze wielkimi literami
  /// Rabat w %, 0–90. Zero jest dozwolone **tylko** razem z `freeShipping` –
  /// kod musi cokolwiek dawać.
  percent   Int
  /// Kod zeruje koszt wysyłki. Może działać sam (percent = 0) albo razem z rabatem.
  freeShipping Boolean @default(false)
  active    Boolean   @default(true)
  // true = rabat dokłada się do przecen produktów i promocji „Wielosztuki”;
  // false = kod działa sam, a sklep wybiera wariant korzystniejszy dla klienta
  stackable Boolean   @default(true)
  // Okno obowiązywania w UTC (panel ustawia je w czasie polskim)
  startsAt  DateTime?
  endsAt    DateTime?
  usedCount Int       @default(0)      // LEGACY: panel liczy użycia z zamówień
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
}

// ─── Promocje ─────────────────────────────────────────────────────────────────

/// Rabat za wolumen: im więcej sztuk w koszyku, tym wyższy procent.
/// Zastąpił wycofaną promocję „Wielosztuki”, która nie dawała klientowi realnej
/// obniżki (podnosiła cenę katalogową o wysyłkę i oddawała ją jako „rabat”).
model QuantityPromo {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  // Okno obowiązywania w UTC (panel ustawia je w czasie polskim) – jak przy kodach
  startsAt DateTime?
  endsAt   DateTime?

  /// true = rabat dokłada się do przecen produktów i kodów;
  /// false = działa sam, a sklep wybiera wariant korzystniejszy dla klienta
  stackable Boolean @default(true)

  /// Czy produkty z własną przeceną liczą się do progu i dostają rabat ilościowy
  includeDiscountedProducts Boolean @default(false)

  /// Zabezpieczenie przed dobijaniem progu tanimi sztukami: pozycja tańsza niż
  /// ta kwota nie liczy się do progu **ani** nie dostaje rabatu
  minItemPrice Float @default(0)

  /// Twardy limit kwoty rabatu na zamówienie (null = bez limitu)
  maxDiscount Float?

  /// Progi: [{ minPieces, minValue, percent }] – walidowane przez lib/quantity-promo.ts
  tiers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Darmowa wysyłka jako promocja z oknem czasu – zastąpiła stałe ustawienia
/// `shipping_free_enabled` / `shipping_free_from`.
model FreeShippingPromo {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  /// Próg wartości koszyka (0 = darmowa wysyłka niezależnie od kwoty)
  minOrderValue Float @default(0)

  /// Których metod dotyczy: courier | parcel_locker (odbiór osobisty jest
  /// bezpłatny zawsze, niezależnie od promocji)
  methods String[] @default(["courier", "parcel_locker"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─── Zamówienia indywidualne ──────────────────────────────────────────────────

model CustomOrder {
  id            String            @id @default(cuid())
  orderNumber   Int               @default(autoincrement()) @unique
  customerName  String
  customerEmail String
  customerPhone String?
  street        String?
  city          String?
  postcode      String?
  orderType     String
  description   String
  deadline      String?
  budget        String?
  price         Float?
  shippingCost  Float?
  paidAmount    Float?
  status        CustomOrderStatus @default(NEW)
  adminNotes    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([customerEmail])
}

enum CustomOrderStatus {
  NEW
  IN_REVIEW
  PAID
  DONE
  CANCELLED
}

// ─── Portfolio (Moje projekty) ────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @default("") @db.Text
  images      String[]
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

// ─── Kategorie produktów ─────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Zużycie AI (generowanie zdjęć produktów) ────────────────────────────────

model AiImageUsage {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  /// "image" (zdjęcia) | "text" (opisy produktów) – rozdziela koszty w panelu
  kind         String   @default("image")
  variant      String // zdjęcia: "ai" | "ai_plus"; tekst: "product_fill"
  model        String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  /// Koszt w USD wyliczony ze stawek modelu (rozliczenie Google jest w USD)
  costUsd      Float    @default(0)
  /// true = model nie zwrócił licznika tokenów, koszt policzony z szacunku
  estimated    Boolean  @default(false)

  @@index([createdAt])
  @@index([model])
}

// ─── Ustawienia sklepu ────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
